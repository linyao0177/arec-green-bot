# Polygon RPC (Alchemy / Infura / public node)
RPC_URL=https://polygon-rpc.com

# Wallet private key (0x...) — KEEP SECRET, never commit
PRIVATE_KEY=0x...

# Wallet address (checksum format)
WALLET_ADDR=0x...

# --- Optional tuning (defaults shown) ---
# POLL_INTERVAL_SEC=300
# CERT_TIMEOUT_HOURS=48
# GREENBTC_DOMAIN_IDS=[2,3,11,12,13,14,15,16,17,18]
# GAS_MULTIPLIER=1.3
